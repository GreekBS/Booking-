DATABASE_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
# Integration tests / Playwright e2e mutation setup — REQUIRED for DB suites.
# Never falls back to DATABASE_URL. Must NOT point at Talos Production
# (Supabase project eofmpszxlumqequjqcmp). Use an isolated non-production PostgreSQL DB.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/hcp_test?schema=public"
# TEST_DIRECT_URL="postgresql://user:password@localhost:5432/hcp_test?schema=public"
# Intentional Production migrate deploy only (never for tests/seed/dev):
# ALLOW_TALOS_PRODUCTION_DB_MUTATION=true
# --- Talos async worker (apps/worker) — NOT Production-activated ---
# Prefer an isolated non-production URL. Refuses Talos Production unless future
# TALOS_WORKER_RUNTIME_MODE=production AND mutation allow-list (no local escape hatch).
# WORKER_DATABASE_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
# LISTEN needs a session/direct connection (transaction poolers often reject LISTEN):
# WORKER_LISTEN_DATABASE_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
# WORKER_RECOVERY_INTERVAL_MS=2000
# TALOS_WORKER_RUNTIME_MODE=  # leave unset for local/dev; never point at Production
# --- Worker schedulers (independent cadences; enqueue-only → durable jobs) ---
# WORKER_ICAL_SCHEDULER_ENABLED=true
# WORKER_ICAL_SCHEDULER_INTERVAL_MS=900000
# WORKER_HOLD_EXPIRY_SCHEDULER_ENABLED=true
# WORKER_HOLD_EXPIRY_SCHEDULER_INTERVAL_MS=60000
# WORKER_HOLD_EXPIRY_JOB_LIMIT=100
# WORKER_PROVIDER_RETRIEVAL_SCHEDULER_ENABLED=false
# WORKER_PROVIDER_RETRIEVAL_SCHEDULER_INTERVAL_MS=30000
# WORKER_HEALTH_PORT=8080
# See docs/talos-railway-worker-deploy.md for Railway provisioning.
# Authoritative Railway config: /railway.toml and /railpack.json at repo root.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Public marketing site origin (canonical URLs, sitemap, Open Graph). Falls back to AUTH_URL / VERCEL_URL.
# NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Optional public contact email shown on marketing contact/footer.
# NEXT_PUBLIC_TALOS_CONTACT_EMAIL="hello@example.com"
OUTBOX_DISPATCH_SECRET="generate-with-openssl-rand-base64-32"
BACKGROUND_JOBS_SECRET="generate-with-openssl-rand-base64-32"
HOLD_EXPIRY_CRON_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-in-production"
# Development-only: grant platform Super Admin to admin@hcp.local during db:seed.
# Enabled only when exactly "true". Default/absent = never promote (safe for shared DBs).
# Production platform-admin bootstrap is a separate operational concern — not db:seed.
# ALLOW_DEV_SUPER_ADMIN_SEED="false"
# CM-4b S3f — admin semantic-mode API (GET/PUT). Enabled only when exactly "true". Default: disabled.
CHANNELS_SEMANTIC_MODE_API_ENABLED="false"
# CM-4b S4a-1 — admin connection/credential/lifecycle operator API. Enabled only when exactly "true". Default: disabled.
CHANNELS_OPERATOR_API_ENABLED="false"
# CM-4b S4a-1 — required for credential seal/unseal when operator credential routes are used.
# Format: base64 encoding of exactly 32 cryptographically random bytes (e.g. openssl rand -base64 32).
# Do not commit a real key. Empty/missing/invalid values fail closed (no encrypt/decrypt).
# Loss of this key makes existing channel_secret_records ciphertext permanently unreadable.
# key_version does not auto-rotate — changing the key without a migration leaves old secrets unreadable.
CHANNELS_CREDENTIALS_MASTER_KEY=
# CM-4b S4a-2a — comma-separated provider allow-list for production registry bootstrap.
# Trimmed, case-sensitive, duplicates/unknown IDs fail closed. Empty = healthy empty registry.
# Production iCal pilot: set exactly "ical" (never register test providers here).
# Booking.com (CM-4c-1): factory exists but stays OFF unless explicitly listed as "booking_com".
# Full enable / verify / rollback: docs/cm-4b-inbound-ical-production-pilot.md
CHANNELS_ENABLED_PROVIDERS=
# CM-4b S4a-2a — poll job execution gate. Enabled only when exactly "true". Default: disabled.
# When false, queued poll_channel_connection jobs complete as a safe no-op (no provider/cursor/inbox work).
# Production iCal pilot also requires CHANNELS_ENABLED_PROVIDERS=ical.
# Job/outbox execution: prefer always-on apps/worker (LISTEN/NOTIFY + recovery sweep).
# Ops HTTP jobs/run + outbox/dispatch remain for manual/recovery. Cron is not the
# primary reservation-critical execution engine (see docs/talos-event-driven-async-worker.md).
# schedule-ical-polls remains the polling *schedule* surface (external or future worker timer).
CHANNELS_POLLING_ENABLED="false"
# P1-S7b — optional iCal poll interval in ms (default 900000 = 15m, minimum 300000 = 5m).
# Not a feature flag. Jitter (0–10%) applies to runAt only, never to the idempotency key.
# CHANNELS_ICAL_POLL_INTERVAL_MS=900000
# P1-S6a / P1-S7c — global inventory apply gate (L1). Enabled only when exactly "true".
# Default false preserves P1-S5 cursor-only CAS. Connection-level
# channel_connections.inventory_apply_enabled (L2, default false) must ALSO be true
# for TX1 generation / TX2 mutation. Never auto-enable in Production.
CHANNELS_INVENTORY_APPLY_ENABLED="false"
# CM-4b S4a-2b — public webhook HTTP. Enabled only when exactly "true". Default: disabled.
CHANNELS_WEBHOOK_API_ENABLED="false"
# CM-4b S4a-2b — admin inbox replay HTTP. Requires CHANNELS_OPERATOR_API_ENABLED as well.
CHANNELS_INBOX_REPLAY_API_ENABLED="false"
