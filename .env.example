DATABASE_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/hcp?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Public marketing site origin (canonical URLs, sitemap, Open Graph). Falls back to AUTH_URL / VERCEL_URL.
# NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Optional public contact email shown on marketing contact/footer.
# NEXT_PUBLIC_TALOS_CONTACT_EMAIL="hello@example.com"
OUTBOX_DISPATCH_SECRET="generate-with-openssl-rand-base64-32"
BACKGROUND_JOBS_SECRET="generate-with-openssl-rand-base64-32"
HOLD_EXPIRY_CRON_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-in-production"
# CM-4b S3f — admin semantic-mode API (GET/PUT). Enabled only when exactly "true". Default: disabled.
CHANNELS_SEMANTIC_MODE_API_ENABLED="false"
# CM-4b S4a-1 — admin connection/credential/lifecycle operator API. Enabled only when exactly "true". Default: disabled.
CHANNELS_OPERATOR_API_ENABLED="false"
# CM-4b S4a-1 — required for credential seal/unseal when operator credential routes are used.
# Format: base64 encoding of exactly 32 cryptographically random bytes (e.g. openssl rand -base64 32).
# Do not commit a real key. Empty/missing/invalid values fail closed (no encrypt/decrypt).
# Loss of this key makes existing channel_secret_records ciphertext permanently unreadable.
# key_version does not auto-rotate — changing the key without a migration leaves old secrets unreadable.
CHANNELS_CREDENTIALS_MASTER_KEY=
# CM-4b S4a-2a — comma-separated provider allow-list for production registry bootstrap.
# Trimmed, case-sensitive, duplicates/unknown IDs fail closed. Empty = healthy empty registry.
# P1-S1: factory catalog includes "ical", but listing it here is required to register.
# Allow-listing ical enables discoverability only; polling remains fail-closed until P1-S2.
CHANNELS_ENABLED_PROVIDERS=
# CM-4b S4a-2a — poll job execution gate. Enabled only when exactly "true". Default: disabled.
# When false, queued poll_channel_connection jobs complete as a safe no-op (no provider/cursor/inbox work).
CHANNELS_POLLING_ENABLED="false"
# P1-S7b — optional iCal poll interval in ms (default 900000 = 15m, minimum 300000 = 5m).
# Not a feature flag. Jitter (0–10%) applies to runAt only, never to the idempotency key.
# CHANNELS_ICAL_POLL_INTERVAL_MS=900000
# P1-S6a / P1-S7c — global inventory apply gate (L1). Enabled only when exactly "true".
# Default false preserves P1-S5 cursor-only CAS. Connection-level
# channel_connections.inventory_apply_enabled (L2, default false) must ALSO be true
# for TX1 generation / TX2 mutation. Phase 1 does not enable production apply.
CHANNELS_INVENTORY_APPLY_ENABLED="false"
# CM-4b S4a-2b — public webhook HTTP. Enabled only when exactly "true". Default: disabled.
CHANNELS_WEBHOOK_API_ENABLED="false"
# CM-4b S4a-2b — admin inbox replay HTTP. Requires CHANNELS_OPERATOR_API_ENABLED as well.
CHANNELS_INBOX_REPLAY_API_ENABLED="false"
