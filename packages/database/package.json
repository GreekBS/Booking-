{
  "name": "@hcp/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./safety": "./src/safety/databaseTargetGuard.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/guarded-prisma.ts migrate deploy",
    "db:migrate:dev": "tsx scripts/guarded-prisma.ts migrate dev",
    "db:push": "tsx scripts/guarded-prisma.ts db push",
    "db:seed": "tsx seed/index.ts",
    "db:studio": "tsx scripts/guarded-prisma.ts studio",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:safety": "vitest run tests/safety",
    "test:last-sa-isolated": "tsx scripts/run-last-sa-isolated-proof.ts",
    "lint": "eslint src --max-warnings 0 && tsc --noEmit"
  },
  "dependencies": {
    "@hcp/domain": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@hcp/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.2",
    "dotenv": "^16.4.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
