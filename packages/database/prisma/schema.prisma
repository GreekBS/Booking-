generator client {
  provider      = "prisma-client-js"
  // native: local/dev (Windows/macOS/Linux). rhel-openssl-3.0.x: Vercel Node serverless.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  active
  suspended
  archived
}

enum PlatformRole {
  super_admin
}

enum TenantRole {
  admin
  manager
}

enum MembershipStatus {
  active
  invited
  revoked
}

enum PropertyType {
  villa
  apartment
  hotel
  other
}

enum PropertyStatus {
  draft
  active
  inactive
  archived
}

enum UnitStatus {
  active
  inactive
  archived
}

enum CancellationPolicyType {
  flexible
  moderate
  strict
}

enum CalendarBlockType {
  manual
  maintenance
  cleaning
  owner
  hold
  booking
  turnover
  channel_import
}

enum ChannelInventoryReconcileStatus {
  pending
  applied
  superseded
  failed
}

enum CalendarBlockStatus {
  active
  released
  expired
  cancelled
}

enum HoldStatus {
  active
  released
  expired
  converted
}

enum BookingStatus {
  pending
  payment_pending
  confirmed
  cancelled
  completed
}

enum DowModifierType {
  fixed
  percent
}

enum PaymentRecordStatus {
  pending
  authorized
  captured
  failed
  cancelled
}

/// F4 settlement lifecycle (ADR-027).
enum PaymentLifecycleStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethodKind {
  CASH
  CARD
  BANK_TRANSFER
  OTA
  OTHER
}

enum PaymentCollectionSource {
  DIRECT
  PROPERTY
  OTA
  PAYMENT_GATEWAY
  OTHER
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ConfirmationMode {
  manual
  payment_required
}

enum PublishableKeyEnvironment {
  test
  live
}

enum OutboxEventStatus {
  pending
  processing
  completed
  dead_letter
}

enum BackgroundJobStatus {
  pending
  processing
  completed
  dead_letter
  cancelled
}

enum ChannelConnectionStatus {
  draft
  pending_auth
  active
  paused
  error
  disconnected
}

enum ChannelFeedSemanticMode {
  mixed_or_unknown_feed
  availability_block_feed
  reservation_feed
}

enum ChannelIcalCredentialRotationStatus {
  in_progress
  committed
  failed
  abandoned
}

enum ChannelSemanticTransitionCommandStatus {
  pending
  committed
}

enum ChannelListingMappingStatus {
  active
  paused
  unmapped
  error
  archived
}

enum ExternalReservationLinkStatus {
  linked
  stale
  conflict
  archived
}

enum ChannelSyncDirection {
  inbound
  outbound
  bidirectional
}

enum ChannelInboxProcessingStatus {
  received
  processing
  completed
  duplicate
  skipped
  failed
  dead_letter
}

enum ChannelInboxProcessingOutcome {
  SUCCESS
  DUPLICATE
  AVAILABILITY_CONFLICT
  VALIDATION_ERROR
  PROVIDER_ERROR
  UNSUPPORTED
  STALE_MAPPING
  TRANSIENT_ERROR
  INTERNAL_ERROR
}

enum ChannelInboxIngressKind {
  webhook
  poll
  replay
  manual
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(63)
  status          TenantStatus @default(active)
  timezone        String       @default("Europe/Athens") @db.VarChar(64)
  defaultLocale   String       @default("en") @map("default_locale") @db.VarChar(10)
  defaultCurrency String       @default("EUR") @map("default_currency") @db.Char(3)
  settings        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz

  memberships                  Membership[]
  invitations                  Invitation[]
  properties                   Property[]
  amenities                    Amenity[]
  commerceSettings             TenantCommerceSettings?
  publishableKeys              TenantPublishableKey[]
  storefrontIdempotencyRecords StorefrontIdempotencyRecord[]
  unitAvailabilityRules        UnitAvailabilityRule[]
  ratePlans                    RatePlan[]
  rateSeasons                  RateSeason[]
  rateDowModifiers             RateDowModifier[]
  unitCalendarBlocks           UnitCalendarBlock[]
  bookingHolds                 BookingHold[]
  quotes                       Quote[]
  bookings                     Booking[]
  paymentRecords               PaymentRecord[]
  payments                     Payment[]
  paymentAllocations           PaymentAllocation[]
  paymentAllocationReversals   PaymentAllocationReversal[]
  paymentRefunds               PaymentRefund[]
  folios                       Folio[]
  folioLines                   FolioLine[]
  taxRules                     TaxRule[]
  businessFiscalProfiles       BusinessFiscalProfile[]
  customerBillingProfiles      CustomerBillingProfile[]
  fiscalSeries                 FiscalSeries[]
  fiscalDocuments              FiscalDocument[]
  fiscalDocumentLines          FiscalDocumentLine[]
  fiscalLineAllocations        FiscalLineAllocation[]

  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique @db.VarChar(255)
  passwordHash  String?       @map("password_hash")
  name          String        @db.VarChar(255)
  platformRole  PlatformRole? @map("platform_role")
  emailVerified DateTime?     @map("email_verified") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  invitations Invitation[] @relation("InvitedBy")
  auditLogs   AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  sessionToken   String   @unique @map("session_token")
  userId         String   @map("user_id") @db.Uuid
  expires        DateTime @db.Timestamptz
  activeTenantId String?  @map("active_tenant_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  role        TenantRole
  propertyIds String[]         @default([]) @map("property_ids") @db.Uuid
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model Invitation {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String     @db.VarChar(255)
  role        TenantRole
  propertyIds String[]   @default([]) @map("property_ids") @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz
  invitedById String     @map("invited_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

model Property {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @map("tenant_id") @db.Uuid
  name                   String                 @db.VarChar(255)
  slug                   String                 @db.VarChar(63)
  description            String?                @db.Text
  type                   PropertyType           @default(villa)
  status                 PropertyStatus         @default(draft)
  timezone               String                 @default("Europe/Athens") @db.VarChar(64)
  addressLine            String?                @map("address_line")
  city                   String?
  region                 String?
  postalCode             String?                @map("postal_code")
  country                String?                @db.Char(2)
  latitude               Decimal?               @db.Decimal(10, 7)
  longitude              Decimal?               @db.Decimal(10, 7)
  checkInTime            String                 @default("15:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime           String                 @default("11:00") @map("check_out_time") @db.VarChar(5)
  cancellationPolicyType CancellationPolicyType @default(moderate) @map("cancellation_policy_type")
  deletedAt              DateTime?              @map("deleted_at") @db.Timestamptz
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units          Unit[]
  amenities      PropertyAmenity[]
  calendarBlocks UnitCalendarBlock[]
  bookingHolds   BookingHold[]
  quotes         Quote[]
  bookings       Booking[]
  payments       Payment[]
  channelConnections ChannelConnection[]
  businessFiscalProfiles BusinessFiscalProfile[]
  fiscalSeries           FiscalSeries[]
  fiscalDocuments        FiscalDocument[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("properties")
}

model Unit {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  name       String     @db.VarChar(255)
  slug       String     @db.VarChar(63)
  maxGuests  Int        @map("max_guests")
  bedrooms   Int        @default(1)
  bathrooms  Int        @default(1)
  status     UnitStatus @default(active)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  availabilityRule UnitAvailabilityRule?
  ratePlan         RatePlan?
  calendarBlocks   UnitCalendarBlock[]
  bookingHolds     BookingHold[]
  quotes           Quote[]
  bookings         Booking[]

  @@unique([propertyId, slug])
  @@index([tenantId, propertyId])
  @@index([tenantId, status])
  @@map("units")
}

model Amenity {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(100)
  icon     String? @db.VarChar(50)
  category String? @db.VarChar(50)

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties PropertyAmenity[]

  @@index([tenantId])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id") @db.Uuid
  amenityId  String @map("amenity_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @map("tenant_id") @db.Uuid
  aggregateType String            @map("aggregate_type") @db.VarChar(50)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(100)
  payload       Json
  deliveryKey   String?           @map("delivery_key") @db.Char(64)
  status        OutboxEventStatus @default(pending)
  attemptCount  Int               @default(0) @map("attempt_count")
  lastError     String?           @map("last_error") @db.Text
  claimedAt     DateTime?         @map("claimed_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime?         @map("processed_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String?             @map("tenant_id") @db.Uuid
  jobType        String              @map("job_type") @db.VarChar(100)
  payload        Json
  status         BackgroundJobStatus @default(pending)
  priority       Int                 @default(0) @db.SmallInt
  runAt          DateTime            @default(now()) @map("run_at") @db.Timestamptz
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(255)
  attemptCount   Int                 @default(0) @map("attempt_count")
  maxAttempts    Int                 @default(5) @map("max_attempts")
  lastError      String?             @map("last_error") @db.Text
  claimedAt      DateTime?           @map("claimed_at") @db.Timestamptz
  nextRetryAt    DateTime?           @map("next_retry_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime?           @map("started_at") @db.Timestamptz
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamptz

  @@unique([jobType, idempotencyKey])
  @@index([status, runAt, nextRetryAt, priority, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([status, completedAt])
  @@map("background_jobs")
}

model TenantCommerceSettings {
  tenantId              String           @id @map("tenant_id") @db.Uuid
  defaultHoldTtlSeconds Int              @default(900) @map("default_hold_ttl_seconds")
  confirmationMode      ConfirmationMode @default(manual) @map("confirmation_mode")
  defaultCurrency       String           @default("EUR") @map("default_currency") @db.Char(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_commerce_settings")
}

model TenantPublishableKey {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  keyHash        String                    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix      String                    @map("key_prefix") @db.VarChar(32)
  environment    PublishableKeyEnvironment
  allowedDomains String[]                  @default([]) @map("allowed_domains")
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_publishable_keys")
}

model StorefrontIdempotencyRecord {
  tenantId       String   @map("tenant_id") @db.Uuid
  scope          String   @db.VarChar(20)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, scope, idempotencyKey])
  @@index([expiresAt])
  @@map("storefront_idempotency_records")
}

model UnitAvailabilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  unitId         String   @unique @map("unit_id") @db.Uuid
  minNights      Int      @default(1) @map("min_nights")
  maxNights      Int      @default(30) @map("max_nights")
  checkInDays    Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("check_in_days")
  checkOutDays   Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("check_out_days")
  advanceMinDays Int      @default(0) @map("advance_min_days")
  advanceMaxDays Int      @default(365) @map("advance_max_days")
  turnoverNights Int      @default(0) @map("turnover_nights")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("unit_availability_rules")
}

model RatePlan {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  unitId            String   @unique @map("unit_id") @db.Uuid
  baseNightlyAmount Decimal  @map("base_nightly_amount") @db.Decimal(19, 4)
  currency          String   @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  seasons      RateSeason[]
  dowModifiers RateDowModifier[]

  @@index([tenantId])
  @@map("rate_plans")
}

model RateSeason {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  ratePlanId    String   @map("rate_plan_id") @db.Uuid
  name          String   @db.VarChar(100)
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  nightlyAmount Decimal  @map("nightly_amount") @db.Decimal(19, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, ratePlanId])
  @@map("rate_seasons")
}

model RateDowModifier {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  ratePlanId    String          @map("rate_plan_id") @db.Uuid
  dayOfWeek     Int             @map("day_of_week")
  modifierType  DowModifierType @map("modifier_type")
  modifierValue Decimal         @map("modifier_value") @db.Decimal(19, 4)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, dayOfWeek])
  @@index([tenantId, ratePlanId])
  @@map("rate_dow_modifiers")
}

model UnitCalendarBlock {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  unitId     String              @map("unit_id") @db.Uuid
  propertyId String              @map("property_id") @db.Uuid
  blockType  CalendarBlockType   @map("block_type")
  sourceId   String?             @map("source_id") @db.Uuid
  checkIn    DateTime            @map("check_in") @db.Date
  checkOut   DateTime            @map("check_out") @db.Date
  status     CalendarBlockStatus @default(active)
  reason     String?             @db.Text
  expiresAt  DateTime?           @map("expires_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // P1-S6b provider ownership (nullable except channel_import via DB CHECK)
  connectionId          String? @map("connection_id") @db.VarChar(255)
  semanticConfigVersion Int?    @map("semantic_config_version")
  mappingId             String? @map("mapping_id") @db.VarChar(255)
  sourceIdentityKey     String? @map("source_identity_key") @db.VarChar(324)
  entryContentHash      String? @map("entry_content_hash") @db.Char(64)
  identityKind          String? @map("identity_kind") @db.VarChar(16)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, unitId, blockType, status])
  @@index([sourceId])
  @@index([tenantId, connectionId, mappingId, blockType, status], map: "unit_calendar_blocks_channel_import_lookup_idx")
  @@map("unit_calendar_blocks")
}

model BookingHold {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  unitId         String     @map("unit_id") @db.Uuid
  propertyId     String     @map("property_id") @db.Uuid
  checkIn        DateTime   @map("check_in") @db.Date
  checkOut       DateTime   @map("check_out") @db.Date
  guestCount     Int        @map("guest_count")
  status         HoldStatus @default(active)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz
  idempotencyKey String?    @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@index([tenantId, unitId, status])
  @@index([tenantId, checkIn, checkOut])
  @@map("booking_holds")
}

model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  holdId      String   @map("hold_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  snapshotId  String   @map("snapshot_id") @db.Uuid
  snapshot    Json
  currency    String   @db.Char(3)
  totalAmount Decimal  @map("total_amount") @db.Decimal(19, 4)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hold     BookingHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId, holdId])
  @@map("quotes")
}

model Booking {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  unitId             String           @map("unit_id") @db.Uuid
  propertyId         String           @map("property_id") @db.Uuid
  quoteId            String           @map("quote_id") @db.Uuid
  holdId             String           @map("hold_id") @db.Uuid
  quoteSnapshotId    String           @map("quote_snapshot_id") @db.Uuid
  guestName          String           @map("guest_name") @db.VarChar(255)
  guestEmail         String           @map("guest_email") @db.VarChar(255)
  guestPhone         String?          @map("guest_phone") @db.VarChar(50)
  guestCount         Int              @map("guest_count")
  checkIn            DateTime         @map("check_in") @db.Date
  checkOut           DateTime         @map("check_out") @db.Date
  status             BookingStatus    @default(pending)
  confirmationMode   ConfirmationMode @map("confirmation_mode")
  totalAmount        Decimal          @map("total_amount") @db.Decimal(19, 4)
  currency           String           @db.Char(3)
  confirmedAt        DateTime?        @map("confirmed_at") @db.Timestamptz
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz
  cancellationReason String?          @map("cancellation_reason") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  paymentRecords PaymentRecord[]
  payments       Payment[]
  folios         Folio[]

  @@index([tenantId, unitId, checkIn, checkOut])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("bookings")
}

/// Legacy gateway intent ledger (ADR-015). Not F4 settlement truth — see `Payment` / `payments`.
model PaymentRecord {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  bookingId         String              @map("booking_id") @db.Uuid
  amount            Decimal             @db.Decimal(19, 4)
  currency          String              @db.Char(3)
  status            PaymentRecordStatus @default(pending)
  provider          String              @default("stub") @db.VarChar(32)
  providerReference String?             @map("provider_reference") @db.VarChar(255)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookingId])
  @@map("payment_records")
}

/// F4 settlement truth (ADR-027). Authoritative payment + allocation + refund ledger.
model Payment {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  /// Canonical property ownership (Active Property 1.1). Required; independent of booking.
  propertyId        String                   @map("property_id") @db.Uuid
  currency          String                   @db.Char(3)
  amount            Decimal                  @db.Decimal(19, 4)
  status            PaymentLifecycleStatus
  method            PaymentMethodKind
  collectionSource  PaymentCollectionSource  @map("collection_source")
  externalReference String?                  @map("external_reference") @db.VarChar(255)
  payerName         String?                  @map("payer_name") @db.VarChar(255)
  bookingId         String?                  @map("booking_id") @db.Uuid
  idempotencyKey    String                   @map("idempotency_key") @db.VarChar(128)
  metadata          Json                     @default("{}")
  receivedAt        DateTime                 @map("received_at") @db.Timestamptz
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property             Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  booking              Booking?                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  allocations          PaymentAllocation[]
  allocationReversals  PaymentAllocationReversal[]
  refunds              PaymentRefund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
  @@index([tenantId, bookingId])
  @@index([tenantId, propertyId])
  @@index([tenantId, propertyId, receivedAt])
  @@map("payments")
}

model PaymentAllocation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  paymentId          String   @map("payment_id") @db.Uuid
  folioId            String   @map("folio_id") @db.Uuid
  allocatedAmount    Decimal  @map("allocated_amount") @db.Decimal(19, 4)
  currency           String   @db.Char(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByActorId   String?  @map("created_by_actor_id") @db.Uuid
  reason             String?  @db.VarChar(512)
  metadata           Json     @default("{}")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  folio     Folio   @relation(fields: [folioId], references: [id], onDelete: Restrict)
  reversals PaymentAllocationReversal[]

  @@index([tenantId, paymentId])
  @@index([tenantId, folioId])
  @@map("payment_allocations")
}

model PaymentAllocationReversal {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  allocationId     String   @map("allocation_id") @db.Uuid
  reversedAmount   Decimal  @map("reversed_amount") @db.Decimal(19, 4)
  currency         String   @db.Char(3)
  reason           String   @db.VarChar(512)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByActorId String?  @map("created_by_actor_id") @db.Uuid
  metadata         Json     @default("{}")
  idempotencyKey   String?  @map("idempotency_key") @db.VarChar(128)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocation PaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([tenantId, allocationId])
  @@index([tenantId, paymentId])
  @@map("payment_allocation_reversals")
}

model PaymentRefund {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  paymentId         String              @map("payment_id") @db.Uuid
  amount            Decimal             @db.Decimal(19, 4)
  currency          String              @db.Char(3)
  status            PaymentRefundStatus
  reason            String?             @db.VarChar(512)
  externalReference String?             @map("external_reference") @db.VarChar(255)
  idempotencyKey    String              @map("idempotency_key") @db.VarChar(128)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  createdByActorId  String?             @map("created_by_actor_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, paymentId])
  @@map("payment_refunds")
}

enum FolioStatus {
  open
  closed
}

enum FolioLineType {
  accommodation
  extra
  service
  discount
  adjustment
  fee
  tax
}

/// Billing settlement surface — not a fiscal document (F1).
model Folio {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  bookingId String      @map("booking_id") @db.Uuid
  /// Distinguishes intentional multi-folios; default open uses "primary".
  folioKey  String      @map("folio_key") @db.VarChar(64)
  currency  String      @db.Char(3)
  status    FolioStatus @default(open)
  label     String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lines              FolioLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([tenantId, bookingId, folioKey])
  @@index([tenantId, bookingId])
  @@map("folios")
}

/// Append-only posted financial lines. No update/delete of posted amounts.
model FolioLine {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  folioId       String           @map("folio_id") @db.Uuid
  lineType      FolioLineType    @map("line_type")
  description   String           @db.VarChar(512)
  amount        Decimal          @db.Decimal(19, 4)
  currency      String           @db.Char(3)
  sourceType    String           @map("source_type") @db.VarChar(64)
  sourceId      String           @map("source_id") @db.VarChar(255)
  sourceLineRef String?          @map("source_line_ref") @db.VarChar(255)
  sortOrder     Int              @map("sort_order")
  postedAt      DateTime         @map("posted_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Immutable tax/levy evaluation snapshot (F2). Never a live TaxRule FK.
  taxSnapshot   Json?            @map("tax_snapshot")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio  Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([tenantId, folioId, sortOrder])
  @@unique([tenantId, folioId, sourceType, sourceId, sourceLineRef])
  @@map("folio_lines")
}

enum TaxRuleScope {
  platform_statutory
  tenant_commercial
}

enum TaxType {
  vat
  climate_resilience_fee
  other_levy
}

enum TaxCalculationKind {
  PERCENTAGE
  FIXED_PER_NIGHT
  FIXED_PER_ROOM
  FIXED_PER_STAY
  PER_PERSON
  PER_PERSON_PER_NIGHT
}

enum TaxBasis {
  NET
  GROSS
  QUANTITY
}

enum CustomerBillingType {
  INDIVIDUAL
  BUSINESS
}

/// Effective-dated tax/levy catalog. Platform statutory rows have null tenantId.
model TaxRule {
  id                       String             @id @db.VarChar(128)
  tenantId                 String?            @map("tenant_id") @db.Uuid
  scope                    TaxRuleScope
  country                  String             @db.Char(2)
  jurisdiction             String             @db.VarChar(64)
  taxType                  TaxType            @map("tax_type")
  classificationKey        String             @map("classification_key") @db.VarChar(128)
  chargeCategory           String?            @map("charge_category") @db.VarChar(64)
  accommodationType        String?            @map("accommodation_type") @db.VarChar(64)
  propertyClassification   String?            @map("property_classification") @db.VarChar(64)
  calculationKind          TaxCalculationKind @map("calculation_kind")
  ratePercent              Decimal?           @map("rate_percent") @db.Decimal(19, 4)
  fixedAmount              Decimal?           @map("fixed_amount") @db.Decimal(19, 4)
  currency                 String             @db.Char(3)
  basis                    TaxBasis
  validFrom                DateTime           @map("valid_from") @db.Timestamptz
  validUntil               DateTime?          @map("valid_until") @db.Timestamptz
  seasonMonths             Int[]              @default([]) @map("season_months")
  floorAreaMinSqm          Int?               @map("floor_area_min_sqm")
  floorAreaMaxExclusiveSqm Int?               @map("floor_area_max_exclusive_sqm")
  legalSource              String?            @map("legal_source") @db.VarChar(512)
  legalVersion             String?            @map("legal_version") @db.VarChar(128)
  priority                 Int                @default(100)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([country, jurisdiction, taxType, classificationKey, validFrom])
  @@index([tenantId])
  @@index([validFrom, validUntil])
  @@map("tax_rules")
}

model BusinessFiscalProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  propertyId             String   @map("property_id") @db.Uuid
  legalName              String   @map("legal_name") @db.VarChar(255)
  tradeName              String?  @map("trade_name") @db.VarChar(255)
  country                String   @db.Char(2)
  vatNumber              String?  @map("vat_number") @db.VarChar(32)
  addressLine1           String   @map("address_line1") @db.VarChar(255)
  addressLine2           String?  @map("address_line2") @db.VarChar(255)
  addressCity            String   @map("address_city") @db.VarChar(128)
  addressRegion          String?  @map("address_region") @db.VarChar(128)
  addressPostalCode      String   @map("address_postal_code") @db.VarChar(32)
  addressCountry         String   @map("address_country") @db.Char(2)
  /// Stable catalog location id — VAT jurisdiction is derived, not free-selected.
  establishmentLocationId String  @default("gr-mainland") @map("establishment_location_id") @db.VarChar(128)
  establishmentInEligibleArea Boolean @default(false) @map("establishment_in_eligible_area")
  servicePhysicallyExecutedInEligibleArea Boolean @default(false) @map("service_physically_executed_in_eligible_area")
  /// Derived VAT jurisdiction (GR | GR-ISLAND-REDUCED).
  fiscalJurisdiction     String   @map("fiscal_jurisdiction") @db.VarChar(64)
  establishmentCode      String?  @map("establishment_code") @db.VarChar(64)
  accommodationType      String   @map("accommodation_type") @db.VarChar(64)
  propertyClassification String?  @map("property_classification") @db.VarChar(64)
  floorAreaSqm           Int?     @map("floor_area_sqm")
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId])
  @@index([tenantId])
  @@map("business_fiscal_profiles")
}

model CustomerBillingProfile {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  type              CustomerBillingType
  legalName         String              @map("legal_name") @db.VarChar(255)
  vatNumber         String?             @map("vat_number") @db.VarChar(32)
  country           String              @db.Char(2)
  addressLine1      String              @map("address_line1") @db.VarChar(255)
  addressLine2      String?             @map("address_line2") @db.VarChar(255)
  addressCity       String              @map("address_city") @db.VarChar(128)
  addressRegion     String?             @map("address_region") @db.VarChar(128)
  addressPostalCode String              @map("address_postal_code") @db.VarChar(32)
  addressCountry    String              @map("address_country") @db.Char(2)
  email             String?             @db.VarChar(255)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("customer_billing_profiles")
}

/// F3: Fiscal document series — next_sequence advanced only inside issue transaction.
model FiscalSeries {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  documentKind  String   @map("document_kind") @db.VarChar(64)
  seriesCode    String   @map("series_code") @db.VarChar(32)
  nextSequence  Int      @map("next_sequence")
  active        Boolean  @default(true)
  label         String?  @db.VarChar(255)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  documents FiscalDocument[]

  @@unique([tenantId, propertyId, documentKind, seriesCode])
  @@index([tenantId])
  @@index([tenantId, propertyId, documentKind, active])
  @@map("fiscal_series")
}

model FiscalDocument {
  id                      String    @id @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  propertyId              String    @map("property_id") @db.Uuid
  documentKind            String    @map("document_kind") @db.VarChar(64)
  status                  String    @db.VarChar(32)
  seriesId                String?   @map("series_id") @db.Uuid
  seriesCode              String?   @map("series_code") @db.VarChar(32)
  sequenceNumber          Int?      @map("sequence_number")
  issuanceIdempotencyKey  String?   @map("issuance_idempotency_key") @db.VarChar(128)
  issuedAt                DateTime? @map("issued_at") @db.Timestamptz
  currency                String    @db.Char(3)
  issuerSnapshot          Json      @map("issuer_snapshot")
  customerSnapshot        Json?     @map("customer_snapshot")
  netTotal                Decimal   @map("net_total") @db.Decimal(19, 4)
  vatTotal                Decimal   @map("vat_total") @db.Decimal(19, 4)
  otherTaxTotal           Decimal   @map("other_tax_total") @db.Decimal(19, 4)
  levyTotal               Decimal   @map("levy_total") @db.Decimal(19, 4)
  grossTotal              Decimal   @map("gross_total") @db.Decimal(19, 4)
  roundingPolicy          String    @default("deterministic_money_4dp") @map("rounding_policy") @db.VarChar(64)
  paymentMethodSummary    String?   @map("payment_method_summary") @db.VarChar(255)
  sourceBookingId         String?   @map("source_booking_id") @db.Uuid
  originalDocumentId      String?   @map("original_document_id") @db.Uuid
  creditReason            String?   @map("credit_reason") @db.VarChar(512)
  creditedScope           String?   @map("credited_scope") @db.VarChar(16)
  metadata                Json      @default("{}")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  series      FiscalSeries?        @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  original    FiscalDocument?      @relation("FiscalDocumentCredits", fields: [originalDocumentId], references: [id], onDelete: Restrict)
  credits     FiscalDocument[]     @relation("FiscalDocumentCredits")
  lines       FiscalDocumentLine[]
  allocations FiscalLineAllocation[]

  @@unique([tenantId, seriesId, sequenceNumber])
  @@unique([tenantId, issuanceIdempotencyKey])
  @@index([tenantId, issuedAt])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, sourceBookingId])
  @@index([tenantId, originalDocumentId])
  @@map("fiscal_documents")
}

model FiscalDocumentLine {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  fiscalDocumentId     String   @map("fiscal_document_id") @db.Uuid
  sortOrder            Int      @map("sort_order")
  description          String   @db.VarChar(512)
  quantity             Decimal  @db.Decimal(19, 4)
  unit                 String?  @db.VarChar(64)
  netAmount            Decimal  @map("net_amount") @db.Decimal(19, 4)
  vatAmount            Decimal  @map("vat_amount") @db.Decimal(19, 4)
  levyAmount           Decimal  @map("levy_amount") @db.Decimal(19, 4)
  grossAmount          Decimal  @map("gross_amount") @db.Decimal(19, 4)
  currency             String   @db.Char(3)
  classificationKey    String?  @map("classification_key") @db.VarChar(128)
  taxSnapshot          Json?    @map("tax_snapshot")
  sourceFolioId        String?  @map("source_folio_id") @db.Uuid
  sourceFolioLineId    String?  @map("source_folio_line_id") @db.Uuid
  dailyUseProvenance   Json?    @map("daily_use_provenance")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
