  createdByActorId String?  @map("created_by_actor_id") @db.Uuid
  metadata         Json     @default("{}")
  idempotencyKey   String?  @map("idempotency_key") @db.VarChar(128)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocation PaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([tenantId, allocationId])
  @@index([tenantId, paymentId])
