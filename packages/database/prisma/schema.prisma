enum FolioStatus {
  open
  closed
}

enum FolioLineType {
  accommodation
  extra
  service
  discount
  adjustment
  fee
  tax
}

/// Billing settlement surface — not a fiscal document (F1).
model Folio {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  bookingId String      @map("booking_id") @db.Uuid
  /// Distinguishes intentional multi-folios; default open uses "primary".
  folioKey  String      @map("folio_key") @db.VarChar(64)
  currency  String      @db.Char(3)
  status    FolioStatus @default(open)
  label     String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lines              FolioLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([tenantId, bookingId, folioKey])
  @@index([tenantId, bookingId])
  @@map("folios")
}

/// Append-only posted financial lines. No update/delete of posted amounts.
model FolioLine {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  folioId       String        @map("folio_id") @db.Uuid
  lineType      FolioLineType @map("line_type")
  description   String        @db.VarChar(512)
  amount        Decimal       @db.Decimal(19, 4)
  currency      String        @db.Char(3)
  sourceType    String        @map("source_type") @db.VarChar(64)
  sourceId      String        @map("source_id") @db.VarChar(255)
  sourceLineRef String?       @map("source_line_ref") @db.VarChar(255)
  sortOrder     Int           @map("sort_order")
  postedAt      DateTime      @map("posted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  /// Immutable tax/levy evaluation snapshot (F2). Never a live TaxRule FK.
  taxSnapshot   Json?         @map("tax_snapshot")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio  Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@unique([tenantId, folioId, sourceType, sourceId, sourceLineRef])
  @@index([tenantId, folioId, sortOrder])
  @@map("folio_lines")
}

enum TaxRuleScope {
  platform_statutory
  tenant_commercial
}

enum TaxType {
  vat
  climate_resilience_fee
  other_levy
}

enum TaxCalculationKind {
  PERCENTAGE
  FIXED_PER_NIGHT
  FIXED_PER_ROOM
  FIXED_PER_STAY
  PER_PERSON
  PER_PERSON_PER_NIGHT
}

enum TaxBasis {
  NET
  GROSS
  QUANTITY
}

enum CustomerBillingType {
  INDIVIDUAL
  BUSINESS
}

/// Effective-dated tax/levy catalog. Platform statutory rows have null tenantId.
model TaxRule {
  id                       String             @id @db.VarChar(128)
  tenantId                 String?            @map("tenant_id") @db.Uuid
  scope                    TaxRuleScope
  country                  String             @db.Char(2)
  jurisdiction             String             @db.VarChar(64)
  taxType                  TaxType            @map("tax_type")
  classificationKey        String             @map("classification_key") @db.VarChar(128)
  chargeCategory           String?            @map("charge_category") @db.VarChar(64)
  accommodationType        String?            @map("accommodation_type") @db.VarChar(64)
  propertyClassification   String?            @map("property_classification") @db.VarChar(64)
  calculationKind          TaxCalculationKind @map("calculation_kind")
  ratePercent              Decimal?           @map("rate_percent") @db.Decimal(19, 4)
  fixedAmount              Decimal?           @map("fixed_amount") @db.Decimal(19, 4)
  currency                 String             @db.Char(3)
  basis                    TaxBasis
  validFrom                DateTime           @map("valid_from") @db.Timestamptz
  validUntil               DateTime?          @map("valid_until") @db.Timestamptz
  seasonMonths             Int[]              @default([]) @map("season_months")
  floorAreaMinSqm          Int?               @map("floor_area_min_sqm")
