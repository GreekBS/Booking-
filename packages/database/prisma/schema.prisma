  allocations FiscalLineAllocation[]

  @@index([tenantId, fiscalDocumentId])
  @@index([tenantId, sourceFolioLineId])
  @@map("fiscal_document_lines")
}

/// Amount-level FolioLine ↔ FiscalDocumentLine coverage.
model FiscalLineAllocation {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  folioId              String   @map("folio_id") @db.Uuid
  folioLineId          String   @map("folio_line_id") @db.Uuid
  fiscalDocumentId     String   @map("fiscal_document_id") @db.Uuid
  fiscalDocumentLineId String   @map("fiscal_document_line_id") @db.Uuid
  allocatedAmount      Decimal  @map("allocated_amount") @db.Decimal(19, 4)
  currency             String   @db.Char(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     FiscalDocument     @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  documentLine FiscalDocumentLine @relation(fields: [fiscalDocumentLineId], references: [id], onDelete: Cascade)

  @@index([tenantId, folioId])
  @@index([tenantId, folioLineId])
  @@index([tenantId, fiscalDocumentId])
  @@map("fiscal_line_allocations")
}

model ChannelConnection {
  tenantId String @map("tenant_id") @db.Uuid
  id       String @map("id") @db.VarChar(255)

  provider    String                  @map("provider") @db.VarChar(50)
  displayName String                  @map("display_name") @db.VarChar(255)
  status      ChannelConnectionStatus @map("status")

  credentialRef          String? @map("credential_ref") @db.VarChar(255)
  webhookVerificationRef String? @map("webhook_verification_ref") @db.VarChar(255)
  lastError              String? @map("last_error") @db.VarChar(500)

  semanticMode          ChannelFeedSemanticMode @default(mixed_or_unknown_feed) @map("semantic_mode")
  semanticConfigVersion Int                     @default(1) @map("semantic_config_version")

  /// P1-S7c: connection-scoped inventory mutation fence. Default OFF.
  inventoryApplyEnabled Boolean @default(false) @map("inventory_apply_enabled")

  /// AP 1.2: operator workspace affinity for unmapped drafts. Not exclusive ownership.
  workspacePropertyId String? @map("workspace_property_id") @db.Uuid

  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  workspaceProperty Property? @relation(fields: [workspacePropertyId], references: [id], onDelete: SetNull)

  pollCursor ChannelPollCursor?
  inventoryReconciliations ChannelInventoryReconciliation[]

  @@id([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, workspacePropertyId])
  @@map("channel_connections")
}

