generator client {
  provider      = "prisma-client-js"
  // native: local/dev (Windows/macOS/Linux). rhel-openssl-3.0.x: Vercel Node serverless.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  active
  suspended
  archived
}

enum PlatformRole {
  super_admin
}

enum TenantRole {
  admin
  manager
}

enum MembershipStatus {
  active
  invited
  revoked
}

enum PropertyType {
  villa
  apartment
  hotel
  other
}

enum PropertyStatus {
  draft
  active
  inactive
  archived
}

enum UnitStatus {
  active
  inactive
  archived
}

enum CancellationPolicyType {
  flexible
  moderate
  strict
}

enum CalendarBlockType {
  manual
  maintenance
  cleaning
  owner
  hold
  booking
  turnover
  channel_import
}

enum ChannelInventoryReconcileStatus {
  pending
  applied
  superseded
  failed
}

enum CalendarBlockStatus {
  active
  released
  expired
  cancelled
}

enum HoldStatus {
  active
  released
  expired
  converted
}

enum BookingStatus {
  pending
  payment_pending
  confirmed
  cancelled
  completed
}

enum ReservationImportBatchStatus {
  draft
  processing
  completed
  completed_with_errors
  failed
  expired
  cancelled
}

enum ReservationImportMissingPriceStrategy {
  undecided
  talos_for_all_missing
  per_row
}

enum ReservationImportRowStatus {
  pending
  ready
  imported
  replaced
  skipped
  skipped_already_imported
  failed
  discarded
}

enum ReservationImportTemporalClass {
  historical
  in_progress
  future
}

enum ReservationImportPriceSource {
  unresolved
  imported_csv
  talos_calculated
  operator_entered
}

enum ReservationImportConflictResolution {
  undecided
  keep_existing
  keep_csv
}

enum DowModifierType {
  fixed
  percent
}

enum PaymentRecordStatus {
  pending
  authorized
  captured
  failed
  cancelled
}

/// F4 settlement lifecycle (ADR-027).
enum PaymentLifecycleStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethodKind {
  CASH
  CARD
  BANK_TRANSFER
  OTA
  OTHER
}

enum PaymentCollectionSource {
  DIRECT
  PROPERTY
  OTA
  PAYMENT_GATEWAY
  OTHER
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ConfirmationMode {
  manual
  payment_required
}

enum PublishableKeyEnvironment {
  test
  live
}

enum DirectBookingIntegrationStatus {
  draft
  active
  disabled
}

enum OutboxEventStatus {
  pending
  processing
  completed
  dead_letter
}

enum BackgroundJobStatus {
  pending
  processing
  completed
  dead_letter
  cancelled
}

enum ChannelConnectionStatus {
  draft
  pending_auth
  active
  paused
  error
  disconnected
}

enum ChannelFeedSemanticMode {
  mixed_or_unknown_feed
  availability_block_feed
  reservation_feed
}

enum ChannelIcalCredentialRotationStatus {
  in_progress
  committed
  failed
  abandoned
}

enum ChannelSemanticTransitionCommandStatus {
  pending
  committed
}

enum ChannelListingMappingStatus {
  active
  paused
  unmapped
  error
  archived
}

enum ExternalReservationLinkStatus {
  linked
  stale
  conflict
  archived
}

enum ChannelSyncDirection {
  inbound
  outbound
  bidirectional
}

enum ChannelInboxProcessingStatus {
  received
  processing
  completed
  duplicate
  skipped
  failed
  dead_letter
}

enum ChannelInboxProcessingOutcome {
  SUCCESS
  DUPLICATE
  AVAILABILITY_CONFLICT
  VALIDATION_ERROR
  PROVIDER_ERROR
  UNSUPPORTED
  STALE_MAPPING
  TRANSIENT_ERROR
  INTERNAL_ERROR
}

enum ChannelInboxIngressKind {
  webhook
  poll
  replay
  manual
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(63)
  status          TenantStatus @default(active)
  timezone        String       @default("Europe/Athens") @db.VarChar(64)
  defaultLocale   String       @default("en") @map("default_locale") @db.VarChar(10)
  defaultCurrency String       @default("EUR") @map("default_currency") @db.Char(3)
  settings        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz

  memberships                    Membership[]
  invitations                    Invitation[]
  properties                     Property[]
  amenities                      Amenity[]
  commerceSettings               TenantCommerceSettings?
  publishableKeys                TenantPublishableKey[]
  storefrontIdempotencyRecords   StorefrontIdempotencyRecord[]
  unitAvailabilityRules          UnitAvailabilityRule[]
  ratePlans                      RatePlan[]
  rateSeasons                    RateSeason[]
  rateDowModifiers               RateDowModifier[]
  unitCalendarBlocks             UnitCalendarBlock[]
  bookingHolds                   BookingHold[]
  quotes                         Quote[]
  bookings                       Booking[]
  reservationImportBatches       ReservationImportBatch[]
  reservationImportRows          ReservationImportRow[]
  paymentRecords                 PaymentRecord[]
  payments                       Payment[]
  paymentAllocations             PaymentAllocation[]
  paymentAllocationReversals     PaymentAllocationReversal[]
  paymentRefunds                 PaymentRefund[]
  folios                         Folio[]
  folioLines                     FolioLine[]
  taxRules                       TaxRule[]
  businessFiscalProfiles         BusinessFiscalProfile[]
  customerBillingProfiles        CustomerBillingProfile[]
  guests                         Guest[]
  guestNotes                     GuestNote[]
  guestTags                      GuestTag[]
  guestTagAssignments            GuestTagAssignment[]
  tasks                          Task[]
  unitHousekeepingStatuses       UnitHousekeepingStatus[]
  fiscalSeries                   FiscalSeries[]
  fiscalDocuments                FiscalDocument[]
  fiscalDocumentLines            FiscalDocumentLine[]
  fiscalLineAllocations          FiscalLineAllocation[]
  unitQrAccess                   UnitQrAccess[]
  cleaningChecklistTemplates     CleaningChecklistTemplate[]
  cleaningChecklistTemplateItems CleaningChecklistTemplateItem[]
  cleaningExecutions             CleaningExecution[]
  cleaningExecutionItems         CleaningExecutionItem[]
  cleaningPhotos                 CleaningPhoto[]
  cleaningLocations              CleaningLocation[]
  cleaningLocationStatuses       CleaningLocationStatus[]
  cleaningLocationQrAccess       CleaningLocationQrAccess[]
  propertyAssistantProfiles      PropertyAssistantProfile[]
  propertyGuestKnowledge         PropertyGuestKnowledge[]
  propertyFaqItems               PropertyFaqItem[]
  conversations                  Conversation[]
  messages                       Message[]
  aiSuggestions                  AiSuggestion[]
  ownerEscalations               OwnerEscalation[]
  aiUsageRecords                 AiUsageRecord[]
  propertyMessagingSettings      PropertyMessagingSettings[]
  bookingMessagingProfiles       BookingMessagingProfile[]
  messagingAutomationRuns        MessagingAutomationRun[]
  messagingContactTokens         MessagingContactToken[]
  directBookingIntegrations      DirectBookingIntegration[]

  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique @db.VarChar(255)
  passwordHash  String?       @map("password_hash")
  name          String        @db.VarChar(255)
  platformRole  PlatformRole? @map("platform_role")
  emailVerified DateTime?     @map("email_verified") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  invitations            Invitation[]             @relation("InvitedBy")
  auditLogs              AuditLog[]
  guestNotes             GuestNote[]
  guestTagAssignments    GuestTagAssignment[]
  assignedTasks          Task[]                   @relation("TaskAssignee")
  createdTasks           Task[]                   @relation("TaskCreator")
  housekeepingUpdates         UnitHousekeepingStatus[] @relation("HousekeepingUpdater")
  cleaningLocationUpdates     CleaningLocationStatus[] @relation("CleaningLocationUpdater")
  startedCleanings            CleaningExecution[]      @relation("CleaningStartedBy")
  completedCleanings          CleaningExecution[]      @relation("CleaningCompletedBy")
  checkedCleaningItems        CleaningExecutionItem[]  @relation("CleaningItemCheckedBy")
  uploadedCleaningPhotos      CleaningPhoto[]          @relation("CleaningPhotoUploader")
  messagesCreated             Message[]                @relation("MessageCreator")
  escalationsAnswered         OwnerEscalation[]        @relation("EscalationAnswerer")
  reservationImportBatches    ReservationImportBatch[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  sessionToken   String   @unique @map("session_token")
  userId         String   @map("user_id") @db.Uuid
  expires        DateTime @db.Timestamptz
  activeTenantId String?  @map("active_tenant_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  role        TenantRole
  propertyIds String[]         @default([]) @map("property_ids") @db.Uuid
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model Invitation {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String     @db.VarChar(255)
  role        TenantRole
  propertyIds String[]   @default([]) @map("property_ids") @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz
  invitedById String     @map("invited_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

model Property {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @map("tenant_id") @db.Uuid
  name                   String                 @db.VarChar(255)
  slug                   String                 @db.VarChar(63)
  description            String?                @db.Text
  type                   PropertyType           @default(villa)
  status                 PropertyStatus         @default(draft)
  timezone               String                 @default("Europe/Athens") @db.VarChar(64)
  addressLine            String?                @map("address_line")
  city                   String?
  region                 String?
  postalCode             String?                @map("postal_code")
  country                String?                @db.Char(2)
  latitude               Decimal?               @db.Decimal(10, 7)
  longitude              Decimal?               @db.Decimal(10, 7)
  checkInTime            String                 @default("15:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime           String                 @default("11:00") @map("check_out_time") @db.VarChar(5)
  cancellationPolicyType CancellationPolicyType @default(moderate) @map("cancellation_policy_type")
  deletedAt              DateTime?              @map("deleted_at") @db.Timestamptz
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units                      Unit[]
  amenities                  PropertyAmenity[]
  calendarBlocks             UnitCalendarBlock[]
  bookingHolds               BookingHold[]
  quotes                     Quote[]
  bookings                   Booking[]
  payments                   Payment[]
  channelConnections         ChannelConnection[]
  businessFiscalProfiles     BusinessFiscalProfile[]
  fiscalSeries               FiscalSeries[]
  fiscalDocuments            FiscalDocument[]
  guestNotes                 GuestNote[]
  tasks                      Task[]
  unitHousekeepingStatuses   UnitHousekeepingStatus[]
  unitQrAccess               UnitQrAccess[]
  cleaningChecklistTemplates CleaningChecklistTemplate[]
  cleaningExecutions         CleaningExecution[]
  cleaningPhotos             CleaningPhoto[]
  cleaningLocations          CleaningLocation[]
  cleaningLocationStatuses   CleaningLocationStatus[]
  cleaningLocationQrAccess   CleaningLocationQrAccess[]
  assistantProfile           PropertyAssistantProfile?
  guestKnowledge             PropertyGuestKnowledge?
  faqItems                   PropertyFaqItem[]
  conversations              Conversation[]
  messages                   Message[]
  aiSuggestions              AiSuggestion[]
  ownerEscalations           OwnerEscalation[]
  aiUsageRecords             AiUsageRecord[]
  messagingSettings          PropertyMessagingSettings?
  bookingMessagingProfiles   BookingMessagingProfile[]
  messagingAutomationRuns    MessagingAutomationRun[]
  messagingContactTokens     MessagingContactToken[]
  directBookingIntegrations  DirectBookingIntegration[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("properties")
}

model Unit {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  name       String     @db.VarChar(255)
  slug       String     @db.VarChar(63)
  maxGuests  Int        @map("max_guests")
  bedrooms   Int        @default(1)
  bathrooms  Int        @default(1)
  status     UnitStatus @default(active)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  availabilityRule   UnitAvailabilityRule?
  ratePlan           RatePlan?
  calendarBlocks     UnitCalendarBlock[]
  bookingHolds       BookingHold[]
  quotes             Quote[]
  bookings           Booking[]
  reservationImportRows ReservationImportRow[]
  tasks              Task[]
  housekeepingStatus UnitHousekeepingStatus?
  qrAccess           UnitQrAccess[]
  cleaningExecutions CleaningExecution[]
  cleaningPhotos     CleaningPhoto[]
  linkedCleaningLocations   CleaningLocation[]
  directBookingIntegrations DirectBookingIntegration[]

  @@unique([propertyId, slug])
  @@index([tenantId, propertyId])
  @@index([tenantId, status])
  @@map("units")
}

model Amenity {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(100)
  icon     String? @db.VarChar(50)
  category String? @db.VarChar(50)

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties PropertyAmenity[]

  @@index([tenantId])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id") @db.Uuid
  amenityId  String @map("amenity_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @map("tenant_id") @db.Uuid
  aggregateType String            @map("aggregate_type") @db.VarChar(50)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(100)
  payload       Json
  deliveryKey   String?           @map("delivery_key") @db.Char(64)
  status        OutboxEventStatus @default(pending)
  attemptCount  Int               @default(0) @map("attempt_count")
  lastError     String?           @map("last_error") @db.Text
  claimedAt     DateTime?         @map("claimed_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime?         @map("processed_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String?             @map("tenant_id") @db.Uuid
  jobType        String              @map("job_type") @db.VarChar(100)
  payload        Json
  status         BackgroundJobStatus @default(pending)
  priority       Int                 @default(0) @db.SmallInt
  runAt          DateTime            @default(now()) @map("run_at") @db.Timestamptz
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(255)
  attemptCount   Int                 @default(0) @map("attempt_count")
  maxAttempts    Int                 @default(5) @map("max_attempts")
  lastError      String?             @map("last_error") @db.Text
  claimedAt      DateTime?           @map("claimed_at") @db.Timestamptz
  nextRetryAt    DateTime?           @map("next_retry_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime?           @map("started_at") @db.Timestamptz
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamptz

  @@unique([jobType, idempotencyKey])
  @@index([status, runAt, nextRetryAt, priority, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([status, completedAt])
  @@map("background_jobs")
}

model TenantCommerceSettings {
  tenantId              String           @id @map("tenant_id") @db.Uuid
  defaultHoldTtlSeconds Int              @default(900) @map("default_hold_ttl_seconds")
  confirmationMode      ConfirmationMode @default(manual) @map("confirmation_mode")
  defaultCurrency       String           @default("EUR") @map("default_currency") @db.Char(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_commerce_settings")
}

model TenantPublishableKey {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  keyHash        String                    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix      String                    @map("key_prefix") @db.VarChar(32)
  environment    PublishableKeyEnvironment
  allowedDomains String[]                  @default([]) @map("allowed_domains")
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_publishable_keys")
}

/**
 * Property-scoped Direct Booking public integration.
 * Opaque public key identifies the Property/Unit for external websites/BFFs.
 * Does not replace tenant-wide storefront publishable keys.
 */
model DirectBookingIntegration {
  id              String                         @id @default(uuid()) @db.Uuid
  tenantId        String                         @map("tenant_id") @db.Uuid
  propertyId      String                         @map("property_id") @db.Uuid
  /** Commercial unit bound to this integration; required for V1. */
  unitId          String                         @map("unit_id") @db.Uuid
  publicKeyHash   String                         @unique @map("public_key_hash") @db.VarChar(64)
  publicKeyPrefix String                         @map("public_key_prefix") @db.VarChar(32)
  environment     PublishableKeyEnvironment
  allowedOrigins  String[]                       @default([]) @map("allowed_origins")
  status          DirectBookingIntegrationStatus @default(draft)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                       @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@index([status])
  @@map("direct_booking_integrations")
}

model StorefrontIdempotencyRecord {
  tenantId       String   @map("tenant_id") @db.Uuid
  scope          String   @db.VarChar(20)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, scope, idempotencyKey])
  @@index([expiresAt])
  @@map("storefront_idempotency_records")
}

model UnitAvailabilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  unitId         String   @unique @map("unit_id") @db.Uuid
  minNights      Int      @default(1) @map("min_nights")
  maxNights      Int      @default(30) @map("max_nights")
  checkInDays    Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("check_in_days")
  checkOutDays   Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("check_out_days")
  advanceMinDays Int      @default(0) @map("advance_min_days")
  advanceMaxDays Int      @default(365) @map("advance_max_days")
  turnoverNights Int      @default(0) @map("turnover_nights")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("unit_availability_rules")
}

model RatePlan {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  unitId            String   @unique @map("unit_id") @db.Uuid
  baseNightlyAmount Decimal  @map("base_nightly_amount") @db.Decimal(19, 4)
  currency          String   @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

