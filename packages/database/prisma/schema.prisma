  tenantId               String    @map("tenant_id") @db.Uuid
  propertyId             String    @map("property_id") @db.Uuid
  conversationId         String    @map("conversation_id") @db.Uuid
  triggerMessageId       String    @unique @map("trigger_message_id") @db.Uuid
  bookingId              String?   @map("booking_id") @db.Uuid
  guestId                String?   @map("guest_id") @db.Uuid
  classification         String    @db.VarChar(32)
  reason                 String?   @db.Text
  summaryForOwner        String    @map("summary_for_owner") @db.Text
  status                 String    @default("open") @db.VarChar(16)
  ownerRawReply          String?   @map("owner_raw_reply") @db.Text
  answeredByUserId       String?   @map("answered_by_user_id") @db.Uuid
  answeredAt             DateTime? @map("answered_at") @db.Timestamptz
  resultingSuggestionId  String?   @map("resulting_suggestion_id") @db.Uuid
  resultingMessageId     String?   @map("resulting_message_id") @db.Uuid
  saveToKnowledgeOffered Boolean   @default(false) @map("save_to_knowledge_offered")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property            Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversation        Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage      Message        @relation("EscalationTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  booking             Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guest               Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  answeredBy          User?          @relation("EscalationAnswerer", fields: [answeredByUserId], references: [id], onDelete: SetNull)
  resultingSuggestion AiSuggestion?  @relation("EscalationSuggestion", fields: [resultingSuggestionId], references: [id], onDelete: SetNull)
  resultingMessage    Message?       @relation("EscalationResultMessage", fields: [resultingMessageId], references: [id], onDelete: SetNull)

  @@index([tenantId, propertyId, status])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("owner_escalations")
}

model AiUsageRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  propertyId         String?  @map("property_id") @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  provider           String   @db.VarChar(32)
  model              String   @db.VarChar(64)
  operation          String   @db.VarChar(32)
  classification     String?  @db.VarChar(32)
  autoAnswered       Boolean  @default(false) @map("auto_answered")
  escalated          Boolean  @default(false)
  inputTokens        Int?     @map("input_tokens")
  outputTokens       Int?     @map("output_tokens")
  latencyMs          Int?     @map("latency_ms")
  success            Boolean
  errorCode          String?  @map("error_code") @db.VarChar(64)
  estimatedCostMinor Int?     @map("estimated_cost_minor")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, propertyId, createdAt(sort: Desc)])
  @@map("ai_usage_records")
}
