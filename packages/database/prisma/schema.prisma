  pms
  channel_manager
  booking_engine
  website_platform
  none
}

/// Anonymous marketing/sales prospect. Never auto-creates User/Tenant/Membership.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  /// Opaque client submission token for retry idempotency (not email-based).
  submissionId String @unique @map("submission_id") @db.Uuid

  fullName        String  @map("full_name") @db.VarChar(120)
  emailNormalized String  @map("email_normalized") @db.VarChar(255)
  phone           String? @db.VarChar(40)
  country         String  @db.VarChar(100)

  relationship LeadRelationship

  portfolioSize      LeadPortfolioSize       @map("portfolio_size")
  accommodationTypes LeadAccommodationType[] @map("accommodation_types")
  propertyCountry    String                  @map("property_country") @db.VarChar(100)
  propertyCity       String?                 @map("property_city") @db.VarChar(120)
  operatingState     LeadOperatingState      @map("operating_state")

  channels              LeadChannel[] @default([])
  tools                 LeadTool[]    @default([])
  softwareName          String?       @map("software_name") @db.VarChar(120)
  hasWebsite            Boolean?      @map("has_website")
  acceptsDirectBookings Boolean?      @map("accepts_direct_bookings")

  revenueRange LeadRevenueRange? @map("revenue_range")
  interests    LeadInterest[]
  message      String?           @db.VarChar(1000)

  source      LeadSource
  utmSource   String?    @map("utm_source") @db.VarChar(200)
  utmMedium   String?    @map("utm_medium") @db.VarChar(200)
  utmCampaign String?    @map("utm_campaign") @db.VarChar(200)

  status LeadStatus @default(new)

  /// Prospect explicitly requested a demo. Independent of workflow status.
  demoRequestedAt DateTime? @map("demo_requested_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt])
  @@index([status])
  @@index([emailNormalized])
  @@index([demoRequestedAt])
  @@map("leads")
}

/// Opaque per-unit QR access. SHA-256 tokenHash for scan; optional sealed ciphertext for authorized reprint.
/// One ACTIVE row per (tenant, unit) is enforced by a partial unique index in SQL.
model UnitQrAccess {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  unitId          String    @map("unit_id") @db.Uuid
  tokenHash       String    @unique(map: "unit_qr_access_token_hash_uidx") @map("token_hash") @db.Char(64)
  /// AES-256-GCM sealed raw token (IV+tag+ciphertext). Null = legacy hash-only (unrecoverable).
  tokenCiphertext Bytes?    @map("token_ciphertext")
  tokenKeyVersion Int?      @map("token_key_version")
  status          String    @default("ACTIVE") @db.VarChar(16)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt       DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId], map: "unit_qr_access_tenant_property_idx")
  @@map("unit_qr_access")
}

/// QR-1: Property-scoped cleaning checklist. One ACTIVE template per property.
model CleaningChecklistTemplate {
  id                      String   @id @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  propertyId              String   @map("property_id") @db.Uuid
  name                    String   @db.VarChar(120)
  isActive                Boolean  @default(true) @map("is_active")
  version                 Int      @default(1)
  minimumCompletionPhotos Int      @default(0) @map("minimum_completion_photos")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property                        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items      CleaningChecklistTemplateItem[]
  executions CleaningExecution[]

  @@index([tenantId, propertyId], map: "cleaning_checklist_templates_tenant_property_idx")
  @@map("cleaning_checklist_templates")
}

/// QR-1: Ordered checklist line on a template.
model CleaningChecklistTemplateItem {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  label         String   @db.VarChar(255)
  description   String?  @db.Text
  position      Int
  required      Boolean  @default(true)
  photoRequired Boolean  @default(false) @map("photo_required")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template CleaningChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position], map: "cleaning_checklist_template_items_template_pos_idx")
  @@map("cleaning_checklist_template_items")
}

/// QR-1: One cleaning run against a housekeeping Task. One IN_PROGRESS per task.
model CleaningExecution {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  propertyId         String    @map("property_id") @db.Uuid
  unitId             String?   @map("unit_id") @db.Uuid
  cleaningLocationId String?   @map("cleaning_location_id") @db.Uuid
  taskId             String    @map("task_id") @db.Uuid
  templateId         String?   @map("template_id") @db.Uuid
  templateVersion    Int?      @map("template_version")
  status             String    @default("IN_PROGRESS") @db.VarChar(16)
  startedByUserId    String    @map("started_by_user_id") @db.Uuid
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedByUserId  String?   @map("completed_by_user_id") @db.Uuid
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property         Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit             Unit?                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  cleaningLocation CleaningLocation?          @relation(fields: [cleaningLocationId], references: [id], onDelete: Restrict)
  task             Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  template         CleaningChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startedBy        User                       @relation("CleaningStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedBy      User?                      @relation("CleaningCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  items            CleaningExecutionItem[]
  photos           CleaningPhoto[]

  @@index([tenantId, unitId, startedAt(sort: Desc)], map: "cleaning_executions_tenant_unit_idx")
  @@index([tenantId, cleaningLocationId, startedAt(sort: Desc)], map: "cleaning_executions_tenant_location_idx")
  @@index([tenantId, propertyId], map: "cleaning_executions_tenant_property_idx")
  @@map("cleaning_executions")
}

/// QR-1: Immutable label snapshot of a template item at execution start.
model CleaningExecutionItem {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  executionId          String    @map("execution_id") @db.Uuid
  sourceTemplateItemId String?   @map("source_template_item_id") @db.Uuid
