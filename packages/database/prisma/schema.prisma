model ChannelInventoryReconciliation {
  tenantId      String @map("tenant_id") @db.Uuid
  connectionId  String @map("connection_id") @db.VarChar(255)
  cursorVersion Int    @map("cursor_version")

  semanticConfigVersion Int @map("semantic_config_version")
  mappingId             String @map("mapping_id") @db.VarChar(255)
  mappingVersion        Int    @map("mapping_version")
  unitId                String @map("unit_id") @db.VarChar(255)
