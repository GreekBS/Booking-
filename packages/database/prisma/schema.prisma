model Booking {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  unitId             String           @map("unit_id") @db.Uuid
  propertyId         String           @map("property_id") @db.Uuid
  quoteId            String           @map("quote_id") @db.Uuid
  holdId             String           @map("hold_id") @db.Uuid
  quoteSnapshotId    String           @map("quote_snapshot_id") @db.Uuid
  guestName          String           @map("guest_name") @db.VarChar(255)
  guestEmail         String           @map("guest_email") @db.VarChar(255)
  guestPhone         String?          @map("guest_phone") @db.VarChar(50)
  guestCount         Int              @map("guest_count")
  /// CRM Guest identity (tenant-owned). Nullable until linked; snapshots remain authoritative for stay contact.
  guestId            String?          @map("guest_id") @db.Uuid
  checkIn            DateTime         @map("check_in") @db.Date
  checkOut           DateTime         @map("check_out") @db.Date
  status             BookingStatus    @default(pending)
  confirmationMode   ConfirmationMode @map("confirmation_mode")
  totalAmount        Decimal          @map("total_amount") @db.Decimal(19, 4)
  currency           String           @db.Char(3)
  confirmedAt        DateTime?        @map("confirmed_at") @db.Timestamptz
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz
  cancellationReason String?          @map("cancellation_reason") @db.Text
  /// Import supersede: successor booking that replaced this completed stay.
  supersededByBookingId String?   @map("superseded_by_booking_id") @db.Uuid
  supersededAt          DateTime? @map("superseded_at") @db.Timestamptz
  supersedeReason       String?   @map("supersede_reason") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  guest          Guest?          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  supersededByBooking Booking?  @relation("BookingSupersededBy", fields: [supersededByBookingId], references: [id], onDelete: Restrict)
  supersededBookings  Booking[] @relation("BookingSupersededBy")
  paymentRecords PaymentRecord[]
  payments       Payment[]
  folios         Folio[]
  tasks          Task[]
  conversations            Conversation[]
  escalations              OwnerEscalation[]
  messagingProfile         BookingMessagingProfile?
  messagingAutomationRuns  MessagingAutomationRun[]
  messagingContactTokens   MessagingContactToken[]
  importRowsCreated        ReservationImportRow[] @relation("ImportRowCreatedBooking")
  importRowsReplaceTarget  ReservationImportRow[] @relation("ImportRowReplaceBooking")
  importRowsSuperseded     ReservationImportRow[] @relation("ImportRowSupersededBooking")

  @@index([tenantId, unitId, checkIn, checkOut])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, guestId])
  @@index([tenantId, supersededByBookingId])
  @@map("bookings")
}

/// Operator CSV reservation import batch (draft + durable terminal audit).
model ReservationImportBatch {
  id                   String                               @id @default(uuid()) @db.Uuid
  tenantId             String                               @map("tenant_id") @db.Uuid
  actorId              String                               @map("actor_id") @db.Uuid
  sourceNamespace      String                               @default("csv_reservation_import") @map("source_namespace") @db.VarChar(64)
  filename             String                               @db.VarChar(255)
  byteSize             Int?                                 @map("byte_size")
  rowCount             Int                                  @default(0) @map("row_count")
  status               ReservationImportBatchStatus         @default(draft)
  missingPriceStrategy ReservationImportMissingPriceStrategy @default(undecided) @map("missing_price_strategy")
  expiresAt            DateTime                             @map("expires_at") @db.Timestamptz
  committedAt          DateTime?                            @map("committed_at") @db.Timestamptz
  createdAt            DateTime                             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                             @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  rows   ReservationImportRow[]

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("reservation_import_batches")
}

model ReservationImportRow {
  id                   String                              @id @default(uuid()) @db.Uuid
  tenantId             String                              @map("tenant_id") @db.Uuid
  batchId              String                              @map("batch_id") @db.Uuid
  rowNumber            Int                                 @map("row_number")
  sourceNamespace      String                              @default("csv_reservation_import") @map("source_namespace") @db.VarChar(64)
  externalReference    String                              @map("external_reference") @db.VarChar(64)
  unitId               String                              @map("unit_id") @db.Uuid
  checkIn              DateTime                            @map("check_in") @db.Date
  checkOut             DateTime                            @map("check_out") @db.Date
  temporalClass        ReservationImportTemporalClass      @map("temporal_class")
  guestName            String                              @map("guest_name") @db.VarChar(255)
  guestEmail           String                              @map("guest_email") @db.VarChar(255)
  guestPhone           String?                             @map("guest_phone") @db.VarChar(50)
  guestCount           Int                                 @map("guest_count")
  priceSource          ReservationImportPriceSource        @default(unresolved) @map("price_source")
  importedTotalAmount  Decimal?                            @map("imported_total_amount") @db.Decimal(19, 4)
  importedCurrency     String?                             @map("imported_currency") @db.Char(3)
  operatorTotalAmount  Decimal?                            @map("operator_total_amount") @db.Decimal(19, 4)
  operatorCurrency     String?                             @map("operator_currency") @db.Char(3)
  conflictResolution   ReservationImportConflictResolution @default(undecided) @map("conflict_resolution")
  replaceBookingId     String?                             @map("replace_booking_id") @db.Uuid
  conflictSnapshot     Json                                @default("{}") @map("conflict_snapshot")
  conflictGroupId      String?                             @map("conflict_group_id") @db.VarChar(64)
  recheckRequired      Boolean                             @default(false) @map("recheck_required")
  status               ReservationImportRowStatus          @default(pending)
  createdBookingId     String?                             @map("created_booking_id") @db.Uuid
  supersededBookingId  String?                             @map("superseded_booking_id") @db.Uuid
  errorCode            String?                             @map("error_code") @db.VarChar(64)
  errorMessage         String?                             @map("error_message") @db.Text
  payload              Json                                @default("{}")
  processedAt          DateTime?                           @map("processed_at") @db.Timestamptz
  createdAt            DateTime                            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                            @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch             ReservationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  unit              Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  replaceBooking    Booking?               @relation("ImportRowReplaceBooking", fields: [replaceBookingId], references: [id], onDelete: SetNull)
  createdBooking    Booking?               @relation("ImportRowCreatedBooking", fields: [createdBookingId], references: [id], onDelete: SetNull)
  supersededBooking Booking?               @relation("ImportRowSupersededBooking", fields: [supersededBookingId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([tenantId, batchId])
  @@index([tenantId, status])
  @@index([tenantId, sourceNamespace, externalReference])
  @@map("reservation_import_rows")
}

/// Legacy gateway intent ledger (ADR-015). Not F4 settlement truth — see `Payment` / `payments`.
model PaymentRecord {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  bookingId         String              @map("booking_id") @db.Uuid
  amount            Decimal             @db.Decimal(19, 4)
  currency          String              @db.Char(3)
  status            PaymentRecordStatus @default(pending)
  provider          String              @default("stub") @db.VarChar(32)
  providerReference String?             @map("provider_reference") @db.VarChar(255)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookingId])
  @@map("payment_records")
}

/// F4 settlement truth (ADR-027). Authoritative payment + allocation + refund ledger.
model Payment {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  /// Canonical property ownership (Active Property 1.1). Required; independent of booking.
  propertyId        String                  @map("property_id") @db.Uuid
  currency          String                  @db.Char(3)
  amount            Decimal                 @db.Decimal(19, 4)
  status            PaymentLifecycleStatus
  method            PaymentMethodKind
  collectionSource  PaymentCollectionSource @map("collection_source")
  externalReference String?                 @map("external_reference") @db.VarChar(255)
  payerName         String?                 @map("payer_name") @db.VarChar(255)
  bookingId         String?                 @map("booking_id") @db.Uuid
  idempotencyKey    String                  @map("idempotency_key") @db.VarChar(128)
  metadata          Json                    @default("{}")
  receivedAt        DateTime                @map("received_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property            Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  booking             Booking?                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  allocations         PaymentAllocation[]
  allocationReversals PaymentAllocationReversal[]
  refunds             PaymentRefund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
  @@index([tenantId, bookingId])
  @@index([tenantId, propertyId])
  @@index([tenantId, propertyId, receivedAt])
  @@map("payments")
}

model PaymentAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  folioId          String   @map("folio_id") @db.Uuid
  allocatedAmount  Decimal  @map("allocated_amount") @db.Decimal(19, 4)
  currency         String   @db.Char(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByActorId String?  @map("created_by_actor_id") @db.Uuid
  reason           String?  @db.VarChar(512)
  metadata         Json     @default("{}")

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment   Payment                     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  folio     Folio                       @relation(fields: [folioId], references: [id], onDelete: Restrict)
  reversals PaymentAllocationReversal[]

  @@index([tenantId, paymentId])
  @@index([tenantId, folioId])
  @@map("payment_allocations")
}

model PaymentAllocationReversal {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  allocationId     String   @map("allocation_id") @db.Uuid
  reversedAmount   Decimal  @map("reversed_amount") @db.Decimal(19, 4)
