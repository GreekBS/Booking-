# apps/web — copy relevant keys into apps/web/.env.local
# Prefer root .env.example as the full catalog; this file lists web-runtime secrets.

# --- Talos Messaging + AI Guest Receptionist (server-side only) ---
# Never expose these to the browser (no NEXT_PUBLIC_*). Missing key → heuristic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
