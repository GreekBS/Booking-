# apps/web — copy relevant keys into apps/web/.env.local
# Prefer root .env.example as the full catalog; this file lists web-runtime secrets.

# --- Talos Messaging + AI Guest Receptionist (server-side only) ---
# Never expose these to the browser (no NEXT_PUBLIC_*).
# AI_ASSISTANT_PROVIDER: gemini (default, fail-closed) | heuristic (test/demo only) | unavailable
AI_ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Central Talos WhatsApp (Cloud API) ---
# MESSAGING_WHATSAPP_WEBHOOK_ENABLED=true
# MESSAGING_WHATSAPP_VERIFY_TOKEN=
# MESSAGING_WHATSAPP_APP_SECRET=
# META_GRAPH_API_VERSION=v21.0
